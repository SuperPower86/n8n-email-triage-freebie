    {
      "parameters": {
        "jsCode": "// 去掉引用与签名，只保留本次新内容，降低 token 与误判\nconst strip = (h) => String(h || '').replace(/<[^>]+>/g, '\\n')\n  .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/\\n{2,}/g, '\\n');\nconst cut = (t) => t.split(/On .* wrote:|在 .* 写道:|-{3,}原始邮件|Original Message/)[0];\nreturn $input.all().map((i) => {\n  const m = i.json;\n  const body = cut(strip(m.snippet || m.content || m.text)).trim().slice(0, 3000);\n  return { json: {\n    message_id: m.id || m.messageId, from: String(m.from || '').toLowerCase(),\n    subject: String(m.subject || '').slice(0, 200), body,\n    received_at: m.date || new Date().toISOString(),\n    thread_id: m.threadId || m.thread_id,\n  } };\n});"
      },
      "name": "正文清洗",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -420,
        80
      ],
      "id": "f1c7dfed-7185-494b-8cca-631220df5009"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "jsonModeOutput": true,
        "options": {
          "temperature": 0,
          "timeout": 90,
          "maxRetries": 2
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "你是客服邮箱的分诊员。只输出 JSON。\ncategory 只能取：inquiry(询价/合作)、after_sales(售后/故障)、billing(账单/发票/合同)、spam(营销/机器人)、other。\n字段：category、priority(1-5，5 最紧急)、confidence(0-1)、summary(不超过30字中文)、\nextract{company,phone,deadline,amount,product}（缺失填 null）、suggested_reply(不超过60字，仅 inquiry 需要)。\n判断不清时选 other 并把 confidence 给低，不要猜。"
            },
            {
              "role": "user",
              "content": "主题：={{ $json.subject }}\n发件人：={{ $json.from }}\n正文：={{ $json.body }}"
            }
          ]
        }
      },
      "name": "LLM 分类与信息抽取",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.2,
      "position": [
        -180,
        80
      ],
      "id": "81aa1e66-3b3e-4cf4-b502-0c3c46f52613",
      "credentials": {

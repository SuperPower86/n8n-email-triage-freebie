    {
      "parameters": {
        "jsCode": "const raw = $item.json.message?.content ?? $item.json;\nlet p = typeof raw === 'string' ? JSON.parse(raw.replace(/```json|```/g, '')) : raw;\nconst allow = ['inquiry', 'after_sales', 'billing', 'spam', 'other'];\nconst cat = allow.includes(p.category) ? p.category : 'other';\nconst conf = Math.max(0, Math.min(1, Number(p.confidence) || 0));\nconst src = $('正文清洗').first().json;\nreturn [{ json: { ...src, category: cat, confidence: conf, low_conf: conf < 0.6,\n  priority: Math.max(1, Math.min(5, Number(p.priority) || 3)),\n  summary: String(p.summary || '').slice(0, 120), extract: JSON.stringify(p.extract || {}),\n  suggested_reply: String(p.suggested_reply || ''), classified_at: new Date().toISOString() } }];"
      },
